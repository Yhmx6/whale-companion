# 复制本文件为 .env，把 ARK_API_KEY 换成你自己的密钥。
# .env 已被 .gitignore 排除，不会被提交。
#
# 密钥申请：火山引擎 → 方舟（Ark）控制台 → API Key 管理
#   https://console.volcengine.com/ark
# 还需要在控制台「开通管理」里开通对应的模型，否则调用会返回 404。

# 必填：方舟 API Key
ARK_API_KEY=

# 可选：接口地址（默认北京区）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 可选：生图模型。带 260915 / 260628 的日期后缀要和你账号里开通的一致，
# 写错了会报 "model not found"。flash 便宜、pro 质量好。
ARK_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
# 质量优先时换成：
# ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628

# 可选：视觉模型，用来读照片（判断构图/光线/家具/表情）
ARK_VLM_MODEL=doubao-seed-2-1-lite-260915

# 可选：服务监听地址与端口
HOST=127.0.0.1
PORT=8848
